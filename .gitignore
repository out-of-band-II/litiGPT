# Reddit Chatbot Pipeline - .gitignore

# ============================================
# Secrets & Credentials (CRITICAL - NEVER COMMIT)
# ============================================
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.yaml
**/secrets/

# Reddit API credentials
reddit_credentials.json

# Cloud provider credentials
.aws/
.gcloud/
.azure/

# ============================================
# Data Files (Large & Potentially Sensitive)
# ============================================
data/raw/*.jsonl
data/raw/*.json
data/raw/*.csv
data/processed/*.jsonl
data/processed/*.json
data/training/*.jsonl
data/training/*.json

# Keep directory structure but ignore contents
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/training/*
!data/training/.gitkeep

# Backup files
*.backup
*.bak

# ============================================
# Model Files (Large Binary Files)
# ============================================
models/**/*.bin
models/**/*.safetensors
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.h5
models/**/*.onnx

# Keep model directory structure
models/*
!models/.gitkeep
!models/README.md

# LoRA adapters (optional - these are small, could commit)
# models/**/*.safetensors

# Hugging Face cache
.cache/
**/.cache/
transformers_cache/
huggingface/

# ============================================
# MLflow & Experiment Tracking
# ============================================
mlruns/
mlartifacts/
mlflow.db
mlflow_tracking/
*.db
*.db-journal

# Tensorboard logs
runs/
logs/tensorboard/
events.out.tfevents.*

# Weights & Biases
wandb/

# ============================================
# Logs
# ============================================
logs/*.log
logs/**/*.log
*.log
reddit_bot.log
training.log
deployment.log

# Keep logs directory
logs/*
!logs/.gitkeep

# ============================================
# Python
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
virtualenv/
.conda/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# PEP 582
__pypackages__/

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

