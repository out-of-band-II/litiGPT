# ============================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Eclipse
.project
.pydevproject
.settings/

# Atom
.atom/

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# Cloud Provider Files
# ============================================
# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraformrc
terraform.rc

# Kubernetes
*.kubeconfig

# AWS
.aws/credentials
.aws/config

# GCP
*-key.json
service-account*.json

# Azure
.azure/

# ============================================
# Monitoring & Profiling
# ============================================
*.prof
*.lprof
profile_results/
profiling/

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.temp
scratch/
test_outputs/
debug/

# ============================================
# Build & Compilation
# ============================================
*.o
*.a
*.lib
*.dll
*.exe
*.out
*.app

# ============================================
# Archives
# ============================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bz2
*.gz

# ============================================
# Sample/Test Data (Optional)
# ============================================
# Uncomment if you want to ignore test data
# test_data/
# sample_data/
# fixtures/

# ============================================
# Documentation Build
# ============================================
docs/_build/
docs/.doctrees/
site/

# ============================================
# Cache Files
# ============================================
.cache/
*.cache
cache/
__pycache__/

# NPM (if using any JS tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Custom Project Specifics
# ============================================
# Add any project-specific ignores here

# Model checkpoints during training
checkpoints/
checkpoint-*/

# Experimental/scratch scripts
experiments/
scratch.py
test.py
debug.py
tmp_*.py

# Output files
outputs/
results/
predictions/
generated_responses/

# Database files
*.sqlite
*.sqlite3
*.db

# Config (user-specific; config.default.yaml is the tracked template)
config.yaml
config.local.yaml
config.override.yaml
config.dev.yaml
config.prod.yaml
config.colab.yaml

# ============================================
# INCLUDE THESE (Override common ignores)
# ============================================
# Keep directory structure files
!.gitkeep
!README.md

# Keep example configs (without secrets)
!config.example.yaml
!config.default.yaml
!.env.example

# Keep documentation
!docs/**/*.md
!*.md

# Keep Dockerfiles and compose files
!Dockerfile*
!docker-compose*.yml
!.dockerignore

# Keep CI/CD configs
!.github/
!.gitlab-ci.yml
!.circleci/

# Keep requirements
!requirements*.txt
!setup.py
!pyproject.toml

# ============================================
# Notes
# ============================================
# This .gitignore is designed to:
# 1. Protect secrets and credentials
# 2. Avoid committing large model files
# 3. Ignore generated/temporary files
# 4. Keep project structure clean
# 
# CRITICAL: Always review files before committing!
# Use: git status
# Check: git diff --staged
# 
# To forcefully add an ignored file (use carefully):
# git add -f filename

.claude
.mcp*